{
  "name": "daedalus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local mission control for agentic development with Claude Code and Antigravity",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dae": "pnpm --filter @daedalus/web dae",
    "lint": "eslint .",
    "spike:acp": "pnpm --filter @daedalus/spikes acp",
    "spike:pty": "pnpm --filter @daedalus/spikes pty",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
